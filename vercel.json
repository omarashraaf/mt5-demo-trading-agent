{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "runtime": "@vercel/python@4.7.1",
      "maxDuration": 300,
      "includeFiles": "{api/index.py,backend/**/*.py,backend/requirements.txt}",
      "excludeFiles": "{backend/venv/**,backend/.venv/**,backend/env/**,backend/ENV/**,backend/tests/**,backend/research_exports/**,backend/research_artifacts/**,backend/trading_agent.db*,backend/*.log,frontend/**,**/__pycache__/**,**/*.pyc}"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ]
}

