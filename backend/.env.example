# MT5 Demo Trading Agent Backend Configuration
# Copy to .env before running

MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
DB_PATH=trading_agent.db
LOG_LEVEL=INFO
API_HOST=127.0.0.1
API_PORT=8000
# lite: fast local/manual startup. pro: cloud/research background services. auto: pro + scheduled automation background services.
APP_SERVICE_MODE=lite
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.0-flash,gemini-2.0-flash-lite,gemma-4-26b-a4b-it,gemma-4-31b-it
GEMINI_TIMEOUT_SECONDS=12
GEMINI_MAX_RETRIES=1
SMART_EVAL_PER_SYMBOL_TIMEOUT_SECONDS=14
SMART_EVAL_TOTAL_TIMEOUT_SECONDS=60
SMART_EVAL_MAX_CONCURRENT_EVALS=2
SMART_EVAL_MAX_SCAN_SYMBOLS_AUTO=8
SMART_EVAL_MAX_SCAN_SYMBOLS_MANUAL=60
MARKET_TICK_STREAM_INTERVAL_MS=25
ENABLE_BENZINGA=true
BENZINGA_API_KEY=your_benzinga_api_key_here
BENZINGA_TIMEOUT_SECONDS=8
BENZINGA_MAX_RETRIES=2
# Active market mode: all supported asset classes by default
ACTIVE_ASSET_CLASSES=Forex,Indices,Commodities,Stocks,Crypto
ENABLED_SYMBOLS=
DISABLED_SYMBOLS=NATGAS,XNGUSD,NGAS,NG
SYMBOL_PROFILE_OVERRIDES={"US500":"indices","US100":"indices","US30":"indices","GER40":"indices","GOLD":"gold","WTI":"commodities","BRENT":"commodities"}
SAVE_CREDENTIALS_BY_DEFAULT=false
REQUIRE_SECURE_CREDENTIAL_STORAGE=true
ENABLE_RESEARCH_CYCLE=false
AUTO_TRAIN_ON_DEMO=false
AUTO_PROMOTE_ON_DEMO=false
MIN_TRADES_BEFORE_TRAINING=50
TRAINING_WINDOW_DAYS=90
WALK_FORWARD_WINDOWS=5
AUTO_META_TRAINING_ENABLED=true
AUTO_META_TRAIN_INTERVAL_SECONDS=900
AUTO_META_TRAIN_MIN_CLOSED_TRADES=30
AUTO_META_AUTO_APPROVE=true
AUTO_META_MIN_PRECISION=0.50
AUTO_META_MIN_F1=0.45
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_REQUIRED=false
ENABLE_ADMIN_BOOTSTRAP=true
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin
CLOUD_SYNC_ENABLED=true
CLOUD_LOG_TABLE=runtime_logs
CLOUD_SYNC_TIMEOUT_SECONDS=8
API_HEALTH_ALERTS_ENABLED=false
API_HEALTH_ALERT_INTERVAL_SECONDS=60
API_HEALTH_ALERT_COOLDOWN_SECONDS=900
API_HEALTH_SMTP_HOST=smtp.gmail.com
API_HEALTH_SMTP_PORT=587
API_HEALTH_SMTP_USER=
API_HEALTH_SMTP_PASSWORD=
API_HEALTH_ALERT_SENDER_EMAIL=
API_HEALTH_ALERT_RECEIVER_EMAIL=
AUTO_META_MIN_POSITIVE_SAMPLES=20
AUTO_META_TARGET_COLUMN=profitable_after_costs_180m
